{
  "workflow": {
    "version": "2.2.0",
    "limits": {
      "max_review_rounds": 3,
      "max_escalate_count": 2,
      "max_user_confirm_rounds": 3,
      "max_subtask_retries": 3,
      "max_global_retries": 2,
      "max_autofix_attempts": 2,
      "max_integration_review_rounds": 2,
      "max_clarification_rounds": 5
    },
    "timeouts_ms": {
      "worker_execution": 1800000,
      "human_response": 0,
      "pr_review_poll_interval": 60000
    },
    "routing": {
      "_note": "Agent 选型详见 docs/agent-routing.md（单一起源）。本文件保留默认值便于冷启动和 CI 校验，运行时该文件被 docs/agent-routing.md 的偏好覆盖。",
      "plan_agent_type": "claude",
      "review_agent_type": "pi",
      "execution_agent_type": "kimi",
      "complex_execution_agent_type": "kimi",
      "image_agent_type": "grok",
      "fallback_agent_type": "pi",
      "default_model": "sonnet"
    },
    "terminals": {
      "_note": "v2.2.0: 每个 sub-task 的每个 round（execution / review / fix / fallback / pr-fix / integration-review 等）都在共享的 feature worktree 里新开一个终端，不再按 sub-task 隔离 worktree。模型选择在 terminal create 时通过 --command 指定，dispatch 层不支持传 model；CLI 没有 --tags，Agent 身份由 --title 前缀约定和 coordinator 的状态记录（handle→role/round/agent_type）承载。",
      "spawn_per_role": true,
      "close_intermediate_terminals": true
    },
    "merge": {
      "mode": "pr_only",
      "auto_merge_on_approval": false,
      "require_ci_pass": true,
      "delete_branch_after_merge": true
    },
    "observability": {
      "log_level": "INFO",
      "state_file": ".orca/workflow-state.json",
      "trace_all_gates": true
    }
  }
}
