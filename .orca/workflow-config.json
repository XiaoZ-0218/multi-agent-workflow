{
  "workflow": {
    "version": "2.1.0",
    "limits": {
      "max_review_rounds": 3,
      "max_escalate_count": 2,
      "max_user_confirm_rounds": 3,
      "max_subtask_retries": 3,
      "max_global_retries": 2,
      "max_autofix_attempts": 2,
      "max_clarification_rounds": 5
    },
    "timeouts_ms": {
      "worker_execution": 1800000,
      "human_response": 0,
      "pr_review_poll_interval": 60000
    },
    "routing": {
      "_note": "Agent 选型详见 docs/agent-routing.md（单一起源）。本文件保留默认值便于冷启动和 CI 校验，运行时该文件被 docs/agent-routing.md 的偏好覆盖。",
      "plan_agent_type": "Plan",
      "review_agent_type": "pi",
      "execution_agent_type": "claude",
      "complex_execution_agent_type": "kimi",
      "image_agent_type": "grok",
      "fallback_agent_type": "pi",
      "default_model": "sonnet"
    },
    "branch_strategy": {
      "_note": "v2.1.0: 每个 sub-task 一个 worktree + branch。stacked 模式下，有依赖的 sub-task 基于父任务的分支而非 main，以保留并行度。",
      "mode": "stacked",
      "branch_template": "feature/{workflow_slug}/{sub_slug}-{timestamp}",
      "worktree_path_template": "../{workflow_slug}-{sub_slug}",
      "draft_pr_when_stacked": true,
      "rebase_on_parent_merge": true,
      "flip_pr_base_on_parent_merge": true,
      "delete_branch_after_merge": true
    },
    "terminals": {
      "_note": "v2.1.0: 每个 sub-task 的每个 round（execution / review / fix）都开一个新终端，挂在该 sub-task 的 worktree 上。模型选择在 terminal create 时通过 --command 指定，dispatch 层不支持传 model。",
      "spawn_per_role": true,
      "review_terminal_role": "review",
      "execution_terminal_role": "execution",
      "close_intermediate_terminals": true,
      "max_terminals_per_subtask": 8
    },
    "merge": {
      "mode": "pr_only",
      "auto_merge_on_approval": false,
      "require_ci_pass": true,
      "delete_branch_after_merge": true,
      "per_subtask_pr": true
    },
    "observability": {
      "log_level": "INFO",
      "state_file": ".orca/workflow-state.json",
      "trace_all_gates": true
    }
  }
}